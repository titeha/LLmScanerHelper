<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LlmScanHelper</RootNamespace>
    <AssemblyName>LLMScanHelper</AssemblyName>
    <Version>5.0.0</Version>
    <Description>LLM Scan Helper — сканер GGUF + генератор параметров llama-server (WPF/MVVM)</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TieredPGO>true</TieredPGO>
    <!-- Не тащим спутниковые локализации для всех культур -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Артефакты сборки (bin + obj) — в корневом artifacts/ (Directory.Build.props), а не в папках проекта. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Ti-Soft.MvvmUtilites" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Памятка «почему так» в Markdown; файл перенесён в UI.Common; Resource= сохраняет логическое имя для pack://application:,,,/Texts/memo.md -->
    <Resource Include="..\UI\LlmScanHelper.UI.Common\Texts\memo.md" Resource="Texts/memo.md" />
    <!-- Иконка окна (exe-иконка — через ApplicationIcon) -->
    <Resource Include="Assets\app-icon.png" />
    <!-- Иконки кнопок заголовка (шестерёнка / «!») -->
    <Resource Include="Assets\Icons.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Доступ к internal-членам для регрессионных тестов сборки команды -->
    <InternalsVisibleTo Include="LLMScanHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI.Common — SharedViewModels/MainViewModel (net10.0); Core тянется транзитом, но m: в XAML резолвит типы напрямую -->
    <ProjectReference Include="..\UI\LlmScanHelper.UI.Common\LlmScanHelper.UI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\LlmScanHelper.Core\LlmScanHelper.Core.csproj" />
  </ItemGroup>
</Project>
