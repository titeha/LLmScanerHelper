<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LlmScanHelper.Views.MemoTabView">

  <!-- Сырый Markdown с нормальным переносом; парсер прикрутится позже -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <TextBlock x:Name="MemoTextBlock"
               TextWrapping="Wrap"
               FontSize="14"
               Margin="14,10,14,10" />
  </ScrollViewer>
</UserControl>
