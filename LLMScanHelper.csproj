<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LlmScanHelper</RootNamespace>
    <AssemblyName>LLMScanHelper</AssemblyName>
    <Version>5.0.0</Version>
    <Description>LLM Scan Helper — сканер GGUF + генератор параметров llama-server (WPF/MVVM)</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Не тащим спутниковые локализации для всех культур -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Ti-Soft.MvvmUtilites" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Памятка «почему так» в Markdown; парсер — позже, пока сырой текст -->
    <Resource Include="Texts\memo.md" />
    <!-- Иконка окна (exe-иконка — через ApplicationIcon) -->
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
