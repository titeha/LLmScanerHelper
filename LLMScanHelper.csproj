<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LlmScanHelper</RootNamespace>
    <AssemblyName>LLMScanHelper</AssemblyName>
    <Version>4.0.0</Version>
    <Description>LLM Scan Helper — сканер GGUF + генератор параметров llama-server (WPF/MVVM)</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Не тащим спутниковые локализации для всех культур -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
