<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовые стили, чтобы панели выглядали аккуратно и единообразно -->

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="8,6,8,8"/>
    </Style>

    <!-- Строка "Метка: [контрол]" -->
    <Style x:Key="Row" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="Lbl" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="#DD333333"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Mono', 'Courier New'"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#FAFAF2"/>
        <Setter Property="BorderBrush" Value="#CCC"/>
    </Style>

    <Style x:Key="PresetButton" TargetType="Button">
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

</ResourceDictionary>
