<mah:MetroWindow x:Class="LlmScanHelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:LlmScanHelper.Views"
        Title="LLM Scan Helper"
        Width="1400"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        UseLayoutRounding="True"
        ShowTitleBar="True"
        TitleBarHeight="30"
        TitleCharacterCasing="Normal"
        ShowIconOnTitleBar="True"
        Icon="pack://application:,,,/Assets/app-icon.png"
        WindowTransitionsEnabled="False">

  <TabControl SelectedIndex="{Binding SelectedTabIndex}">

    <!-- ==================== ВКЛАДКА: ПАНЕЛЬ ==================== -->
    <TabItem Header="Панель"
             mah:ControlsHelper.ContentCharacterCasing="Normal">
      <views:PanelTabView />
    </TabItem>

    <!-- ==================== ВКЛАДКА: ПАМЯТКА ==================== -->
    <TabItem Header="Памятка (почему так)"
             mah:ControlsHelper.ContentCharacterCasing="Normal">
      <views:MemoTabView />
    </TabItem>

    <!-- ==================== ВКЛАДКА: НАСТРОЙКИ ==================== -->
    <TabItem Header="Настройки"
             mah:ControlsHelper.ContentCharacterCasing="Normal">
      <views:SettingsTabView />
    </TabItem>

  </TabControl>
</mah:MetroWindow>
