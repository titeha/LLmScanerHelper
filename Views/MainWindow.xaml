<mah:MetroWindow x:Class="LlmScanHelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:LlmScanHelper.Views"
        xmlns:t="clr-namespace:LlmScanHelper.Texts"
        Title="LLM Scan Helper"
        Width="1400"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        UseLayoutRounding="True"
        ShowTitleBar="True"
        TitleBarHeight="30"
        TitleCharacterCasing="Normal"
        ShowIconOnTitleBar="True"
        Icon="pack://application:,,,/Assets/app-icon.png"
        WindowTransitionsEnabled="False">

  <!-- Основная логика (скан, выбор модели, GPU, сборка команды) живёт в UserControl,
       прикреплённом к главному окну. -->
  <views:PanelTabView />

  <mah:MetroWindow.RightWindowCommands>
    <mah:WindowCommands mah:ControlsHelper.ContentCharacterCasing="Normal">
      <Button Command="{Binding OpenSettingsCommand}"
              Padding="4"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip="{x:Static t:ToolTips.SettingsButton}"
              Width="28" Height="28">
        <!-- Иконка — в Assets/Icons.xaml (StaticResource), здесь только оформление. -->
        <Path Width="20" Height="20" Stretch="Uniform"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.5" StrokeLineJoin="Round"
              Data="{StaticResource SettingsGear}" />
      </Button>
      <Button Command="{Binding OpenHelpCommand}"
              Padding="4"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip="{x:Static t:ToolTips.HelpButton}"
              Width="28" Height="28">
        <!-- Иконка — в Assets/Icons.xaml (StaticResource), здесь только оформление. -->
        <Path Width="20" Height="20" Stretch="Uniform"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.5" StrokeLineJoin="Round"
              Data="{StaticResource HelpBang}" />
      </Button>
    </mah:WindowCommands>
  </mah:MetroWindow.RightWindowCommands>
</mah:MetroWindow>
